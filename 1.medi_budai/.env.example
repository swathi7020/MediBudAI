# MediBudAI Deployment Configuration

# Production Environment Variables Template
# Copy this to .env and modify values as needed

# =============================================================================
# REQUIRED: OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# Flask Application Settings
# =============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=

# =============================================================================
# Server Configuration
# =============================================================================
# Host: Use 0.0.0.0 for external access, 127.0.0.1 for local only
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =============================================================================
# File Upload Settings
# =============================================================================
# Maximum TOTAL request size in bytes, i.e. the sum of all files in one
# multi-file upload (64MB default = enough for several 16MB PDFs at once)
MAX_CONTENT_LENGTH=67108864

# Maximum size of a single file within a batch, in bytes (16MB default)
MAX_FILE_SIZE=16777216

# Maximum number of files accepted in a single upload request
MAX_FILES_PER_UPLOAD=10

# Maximum number of files analyzed concurrently (thread pool size).
# Bounded by OpenAI rate limits — raise cautiously.
MAX_CONCURRENT_ANALYSES=4

# =============================================================================
# Logging
# =============================================================================
# DEBUG for verbose per-file tracing, INFO for normal operation
LOG_LEVEL=INFO

# Whether to make a live OpenAI API call at process startup to verify the
# key works. Set to false to skip (saves a call on every worker boot).
OPENAI_STARTUP_CHECK=true

# =============================================================================
# Gunicorn (production WSGI server) settings — used by the Dockerfile
# =============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180

# =============================================================================
# Directory Configuration (relative to application root)
# =============================================================================
# These paths are relative to the application directory
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=output
LOGS_FOLDER=logs

# =============================================================================
# Optional: Custom Base Directory
# =============================================================================
# Uncomment and set if you want to use a different base directory
# BASE_DATA_DIR=/var/lib/medibudai

# =============================================================================
# Production Deployment Notes
# =============================================================================
# 1. Set FLASK_ENV=production for production deployments
# 2. Set FLASK_DEBUG=False for production
# 3. Use a strong SECRET_KEY (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# 4. Set FLASK_HOST=0.0.0.0 to accept connections from any IP
# 5. Consider using a reverse proxy (nginx, apache) in front of Flask
# 6. Ensure proper file permissions for upload/output/logs directories
# 7. Set up log rotation for the logs directory
# 8. Consider using a process manager like supervisor or systemd

# =============================================================================
# Security Considerations
# =============================================================================
# - Keep your .env file secure and never commit it to version control
# - Use strong secrets and rotate them regularly  
# - Implement proper firewall rules
# - Consider HTTPS/SSL termination at the reverse proxy level
# - Monitor file storage usage and implement cleanup policies
