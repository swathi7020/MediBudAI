# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environment
venv/
env/
.env

# Ignore uploaded files (but keep the directory)
uploads/*
!uploads/.gitkeep

# Ignore output files (but keep the directory)
output/*
!output/.gitkeep

# Ignore log files (but keep the directory)
logs/*
!logs/.gitkeep

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.temp

# Ignore backup files
*.bak
*.backup
